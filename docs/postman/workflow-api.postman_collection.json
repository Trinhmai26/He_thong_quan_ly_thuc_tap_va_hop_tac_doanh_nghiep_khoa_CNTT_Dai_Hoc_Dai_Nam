{
  "info": {
    "name": "Workflow API M1-M6",
    "description": "Collection test 2 endpoint workflow status transition",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userCode\": \"admin001\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login success', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const data = pm.response.json();",
              "if (data && data.data && data.data.token) {",
              "  pm.collectionVariables.set('token', data.data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Workflow - Update Assignment Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workflow_status\": \"DANG_THUC_TAP\",\n  \"note\": \"postman test assignment transition\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/workflow/assignment/{{assignmentId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workflow",
            "assignment",
            "{{assignmentId}}",
            "status"
          ]
        }
      }
    },
    {
      "name": "Workflow - Update Dang Ky Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workflow_status\": \"DA_DUYET\",\n  \"current_milestone\": \"M3\",\n  \"note\": \"postman test dang ky transition\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/workflow/dang-ky/{{dangKyId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workflow",
            "dang-ky",
            "{{dangKyId}}",
            "status"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "assignmentId",
      "value": "1"
    },
    {
      "key": "dangKyId",
      "value": "1"
    }
  ]
}
