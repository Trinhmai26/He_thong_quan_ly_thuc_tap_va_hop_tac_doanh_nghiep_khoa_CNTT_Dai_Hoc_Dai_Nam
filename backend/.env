# JWT Secret
JWT_SECRET=your_jwt_secret_key_here_make_it_very_long_and_secure
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# Email Configuration (for notifications)
# Để gửi email lịch phỏng vấn qua Gmail:
# 1. Bật "2-Step Verification" tại https://myaccount.google.com/security
# 2. Tạo "App Password" tại https://myaccount.google.com/apppasswords
# 3. Điền địa chỉ Gmail và App Password (16 ký tự) vào bên dưới
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=trinhyenmai06@gmail.com
EMAIL_PASS=ylsylfxgdoigvujb

# Zalo OA Configuration
# Lấy từ: https://developers.zalo.me/app/<app_id>/oa
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token_here
# Secret key dùng để xác thực webhook từ Zalo
ZALO_WEBHOOK_SECRET=your_zalo_webhook_secret_here
# URL công khai của server (dùng cho webhook, cần ngrok hoặc domain thật)
ZALO_WEBHOOK_URL=https://your-domain.com/api/zalo/webhook

# Zalo Local Service (Flask - ZALO/ZALO/app.py)
# Chạy: cd ZALO/ZALO && python app.py
# Dùng zlapi (personal account) để gửi vào nhóm Zalo
ZALO_LOCAL_URL=http://127.0.0.1:5001

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100