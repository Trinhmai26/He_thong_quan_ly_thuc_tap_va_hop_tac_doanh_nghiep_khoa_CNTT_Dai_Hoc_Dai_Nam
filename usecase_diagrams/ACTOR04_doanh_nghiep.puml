@startuml ACTOR04_Doanh_Nghiep

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 55
skinparam usecase {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}
skinparam actor {
  BackgroundColor #FFF9C4
  BorderColor #F57F17
  FontStyle bold
