    (Xem bao cao cuoi ky cua TTS)     as UC601
    (Nhap diem danh gia DN)           as UC602
    (Nhap nhan xet thai do & ky nang) as UC603
    (Nop bao cao danh gia DN)         as UC604
  }

  package "7. Dashboard & Thong ke" as P7 {
    (Xem dashboard doanh nghiep)      as UC701
    (Xem ds TTS theo dot)             as UC702
    (Xem trang thai bao cao TTS)      as UC703
