    (Cap nhat linh vuc & quy mo)      as UC203
    (Cap nhat thong tin lien he)      as UC204
  }

  package "3. Dang ky nhan Thuc tap sinh" as P3 {
    (Dang ky nhan thuc tap sinh)      as UC301
    (Cap nhat dang ky)                as UC302
    (Huy dang ky (truoc khi duyet))   as UC303
